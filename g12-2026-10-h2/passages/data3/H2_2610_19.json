 "sents": [
  {
   "n": 1,
   "en": "Beryl was standing on stage for her singing performance at the school festival.",
   "ko": "Beryl은 학교 축제에서 노래 공연을 하려고 무대 위에 서 있었다."
  },
  {
   "n": 2,
   "en": "The opening melody began to play, a soft tune that Beryl had practiced over and over.",
   "ko": "첫 선율이 흘러나오기 시작했는데, Beryl이 몇 번이고 연습했던 부드러운 곡조였다."
  },
  {
   "n": 3,
   "en": "She knew the lyrics by heart, but now that she was here, everything seemed to have faded from her mind.",
   "ko": "Beryl은 가사를 외우고 있었지만, 막상 이곳에 서자 기억하던 모든 것이 머리에서 지워진 듯했다."
  },
  {
   "n": 4,
   "en": "She almost froze.",
   "ko": "Beryl은 하마터면 얼어붙을 뻔했다."
  },
  {
   "n": 5,
   "en": "What if I forgot the words?",
   "ko": "가사를 잊어버리면 어쩌지?"
  },
  {
   "n": 6,
   "en": "What if I sounded awful?",
   "ko": "내 노래가 형편없게 들리면 어쩌지?"
  },
  {
   "n": 7,
   "en": "But then she remembered her best friend Naomi’s words.",
   "ko": "하지만 그때 Beryl은 가장 친한 친구 Naomi가 해 준 말을 떠올렸다."
  },
  {
   "n": 8,
   "en": "“You’re doing something brave by just getting up there.”",
   "ko": "“무대에 오르기만 해도 넌 이미 용기 있는 일을 해내고 있어.”"
  },
  {
   "n": 9,
   "en": "When the moment came, Beryl took a deep breath and began to sing.",
   "ko": "그 순간이 오자, Beryl은 숨을 깊이 들이쉬고 노래를 부르기 시작했다."
  },
  {
   "n": 10,
   "en": "Her voice, shaky at first, soon found its rhythm as she focused.",
   "ko": "Beryl이 노래에 집중하자, 처음에는 떨리던 목소리가 곧 리듬을 찾았다."
  },
  {
   "n": 11,
   "en": "The weight on her shoulders slowly lifted, and the words began to flow more easily.",
   "ko": "어깨를 짓누르던 무게가 천천히 가벼워졌고, 가사가 더 쉽게 흘러나오기 시작했다."
  },
  {
   "n": 12,
   "en": "As she continued singing, each note rang out without hesitation.",
   "ko": "Beryl이 노래를 이어 가자, 음 하나하나가 망설임 없이 울려 퍼졌다."
  },
  {
   "n": 13,
   "en": "She realized that this was her moment.",
   "ko": "Beryl은 지금이 바로 자신의 순간이라는 것을 깨달았다."
  }
 ],
