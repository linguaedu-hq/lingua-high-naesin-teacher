 "sents": [
  {
   "n": 1,
   "en": "The violin had always been Ann’s thing since she was seven.",
   "ko": "바이올린은 앤이 일곱 살 때부터 늘 가장 좋아하는 것이었다."
  },
  {
   "n": 2,
   "en": "Her teacher Mrs. Jones always said she had natural talent.",
   "ko": "앤의 선생님인 존스 선생님은 앤에게 타고난 재능이 있다고 늘 말했다."
  },
  {
   "n": 3,
   "en": "But lately, every time Ann picked up her bow, she couldn’t focus.",
   "ko": "하지만 요즘 앤은 활을 집어 들 때마다 집중할 수가 없었다."
  },
  {
   "n": 4,
   "en": "She kept thinking about Victoria Gray, the brilliant violinist who had performed at Maestro Hall.",
   "ko": "앤은 마에스트로 홀에서 공연했던 뛰어난 바이올리니스트 빅토리아 그레이를 계속 떠올렸다."
  },
  {
   "n": 5,
   "en": "Before the lesson with Mrs. Jones, Ann was watching Victoria’s flawless technique on her smartphone, and it made her chest feel tighter.",
   "ko": "존스 선생님과의 수업 전에 앤은 휴대폰으로 빅토리아의 흠 없는 연주 기술을 보고 있었는데, 그것을 보자 가슴이 더 답답해졌다."
  },
  {
   "n": 6,
   "en": "What was the point?",
   "ko": "‘그게 다 무슨 소용이었나?’"
  },
  {
   "n": 7,
   "en": "Ann thought.",
   "ko": "앤은 생각했다."
  },
  {
   "n": 8,
   "en": "I’ll never be like her.",
   "ko": "‘나는 앞으로도 그 사람처럼 될 수는 없을 거야.’"
  },
  {
   "n": 9,
   "en": "As the lesson began, her teacher, Mrs. Jones, immediately noticed Ann’s distraction.",
   "ko": "수업이 시작되자 앤의 선생님인 존스 선생님은 앤이 딴생각을 하고 있다는 것을 바로 알아차렸다."
  },
  {
   "n": 10,
   "en": "“Is everything alright, Ann?” asked Mrs. Jones.",
   "ko": "“앤, 괜찮니?” 존스 선생님이 물었다."
  },
  {
   "n": 11,
   "en": "“I’m just wondering if I’m good enough to be special like Victoria,” Ann said.",
   "ko": "“그냥 제가 빅토리아처럼 특별해질 만큼 잘하는지 궁금해서요.” 앤이 말했다."
  },
  {
   "n": 12,
   "en": "“I used to love playing.",
   "ko": "“예전에는 연주하는 게 정말 좋았어요.”"
  },
  {
   "n": 13,
   "en": "Now I just feel like I’m not good enough.",
   "ko": "“그런데 지금은 제가 충분히 잘하지 못하는 것 같아요.”"
  },
  {
   "n": 14,
   "en": "I don’t have the perfect technique like her.”",
   "ko": "“저는 그 사람처럼 완벽한 기술이 없어요.”"
  },
  {
   "n": 15,
   "en": "Hearing her words, Mrs. Jones smiled softly and said, “That’s because you’re measuring yourself against someone else’s ruler.",
   "ko": "앤의 말을 들은 존스 선생님은 살며시 미소 지으며 말했다. “그건 네가 남이 정한 기준에 너를 맞춰 보고 있어서란다.”"
  },
  {
   "n": 16,
   "en": "Comparison steals your joy and unique voice.",
   "ko": "“비교는 너의 기쁨과 너만의 목소리를 빼앗아 간단다.”"
  },
  {
   "n": 17,
   "en": "Stop looking at her journey and focus on your own.”",
   "ko": "“그 사람이 걸어온 길은 그만 보고 너 자신의 길에 집중하렴.”"
  },
  {
   "n": 18,
   "en": "Hearing those comforting words, something profound shifted inside Ann.",
   "ko": "그 따뜻한 말을 듣자 앤의 마음속에서 무언가 깊은 것이 바뀌었다."
  },
  {
   "n": 19,
   "en": "After the lesson, Ann took down Victoria Gray’s picture that had always been on her bedroom wall.",
   "ko": "수업이 끝난 뒤, 앤은 침실 벽에 늘 붙어 있던 빅토리아 그레이의 사진을 떼어 냈다."
  },
  {
   "n": 20,
   "en": "That night, Ann deleted her social media app from her smartphone.",
   "ko": "그날 밤, 앤은 휴대폰에서 소셜 미디어 앱을 지웠다."
  },
  {
   "n": 21,
   "en": "She focused on practicing her violin, trying to find herself, for a week.",
   "ko": "일주일 동안 앤은 자기 자신을 찾으려고 애쓰며 바이올린 연습에만 집중했다."
  },
  {
   "n": 22,
   "en": "On Saturday, Ann picked up her violin and played a simple piece she’d known since childhood.",
   "ko": "토요일에 앤은 바이올린을 들고 어릴 때부터 알던 쉬운 곡 하나를 연주했다."
  },
  {
   "n": 23,
   "en": "Her music had mistakes, but it felt like her own music again.",
   "ko": "연주에는 실수가 있었지만, 다시 자기만의 음악처럼 느껴졌다."
  },
  {
   "n": 24,
   "en": "When she finished, her little sister Emma clapped enthusiastically.",
   "ko": "연주가 끝나자 여동생 에마가 신이 나서 손뼉을 쳤다."
  },
  {
   "n": 25,
   "en": "“When you play, it makes the whole house feel nicer.”",
   "ko": "“언니가 연주하면 온 집 안이 더 좋아지는 느낌이야.”"
  },
  {
   "n": 26,
   "en": "Ann smiled, finally at peace.",
   "ko": "앤은 마침내 마음이 편안해져 미소를 지었다."
  }
 ],
